{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./app/*"],
      "@convex/*": ["../convex/*"],
      "@site-config": ["../site-config"]
    }
  },
  "include": ["app/**/*", "../site-config.ts"],
  "exclude": ["node_modules", "../convex"]
}
