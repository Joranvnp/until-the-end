# ===========================================
# Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  Env vars live in THREE places — putting a value in the wrong one is the
#     #1 source of "it works locally but not in prod":
#
#   1. This .env file        → local dev only (gitignored, never shipped)
#   2. Convex deployment env → backend secrets (npx convex env set KEY value)
#                              Set them PER deployment: dev AND prod (--prod)
#   3. eas.json + Vercel     → values baked into production builds
#                              (.env is gitignored, so EAS/Vercel never see it)
#
# Run `npm run check-setup` anytime to verify everything is in place.

# --- Convex ---
# Created by `npx convex dev`. Two different URLs — don't swap them:
#   *_CONVEX_URL      ends in .convex.cloud  (client → backend functions)
#   *_CONVEX_SITE_URL ends in .convex.site   (HTTP routes: auth, webhooks)
# Always use the CLOUD deployment URLs here. Only point to 127.0.0.1 if you
# intentionally run a local Convex backend (you'll know if you do).
CONVEX_DEPLOYMENT=dev:your-deployment-name
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# --- Web app (same values as above, Vite prefix) ---
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_EMAIL_CONTACT="support@nowstack.app"

# --- Stripe (Android/Web payments) ---
# Publishable key is safe to expose. Get it at https://dashboard.stripe.com/apikeys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secret values go on the Convex deployment, NOT here:
#   npx convex env set STRIPE_SECRET_KEY sk_test_...
#   npx convex env set STRIPE_PRICE_ID price_...

# --- Lumail (sign-in OTP emails) — REQUIRED for email sign-in ---
# Without it, sign-in fails with a clear error. Create an API token at
# https://lumail.io (Settings > API Tokens), then:
#   npx convex env set LUMAIL_API_KEY lum_...
#   npx convex env set EMAIL_FROM "you@yourdomain.com"   (domain must be verified in Lumail)
EMAIL_FROM="support@nowstack.app"

# --- Better Auth — REQUIRED, set on the Convex deployment ---
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   npx convex env set SITE_URL https://yourdomain.com   (http://localhost:3000 for dev)

# --- Apple / Google Sign In (if enabled in site-config.ts > features) ---
#   npx convex env set APPLE_CLIENT_ID ...     npx convex env set APPLE_CLIENT_SECRET ...
#   npx convex env set GOOGLE_CLIENT_ID ...    npx convex env set GOOGLE_CLIENT_SECRET ...

# --- Apple IAP (iOS payments) ---
#   npx convex env set APPLE_SHARED_SECRET ...   (App Store Connect > App Information)

# --- Payments testing without a store account ---
# The paywall shows a "Continue (Dev)" button in dev builds, but the backend
# only accepts it if you explicitly enable it on the Convex deployment:
#   npx convex env set ALLOW_DEV_PAYMENT_BYPASS true
# Never set this on production.

# --- Gemini (AI features, optional) ---
#   npx convex env set GEMINI_API_KEY ...

# --- PostHog (analytics, OPTIONAL — app works fine without it) ---
POSTHOG_PROJECT_TOKEN=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# --- Cloudflare R2 (file storage) ---
# Needed only when you use file uploads. Set on the Convex deployment too:
#   npx convex env set R2_ENDPOINT ... (and the rest below)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-app-storage
R2_PUBLIC_URL=https://your-r2-public-url.com
