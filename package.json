    "@lumail/convex": "^0.1.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "better-auth": "^1.5.6",
    "convex": "^1.41.0",
    "convex-helpers": "^0.1.119",
    "react-dom": "^19.2.7",
    "stripe": "^22.2.1",
    "zod": "^4.4.3"
