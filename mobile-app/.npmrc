# Expo + React 19: react-dom is pulled transitively at a newer patch than the
# pinned react, so npm's strict peer resolver throws ERESOLVE on a clean install.
# react-dom is peerOptional here (web/metro runtime only) — harmless for native
# builds. legacy-peer-deps makes `npm install`/`npm ci` reproducible across machines.
legacy-peer-deps=true
