{
  "name": "nowstack-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "expo-go": "node ../scripts/start-expo-go.mjs",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "screenshots:store": "node scripts/store-screenshots.mjs",
    "screenshots:store:ios": "node scripts/store-screenshots.mjs --platform ios",
    "screenshots:store:android": "node scripts/store-screenshots.mjs --platform android",
    "env:dev": "node scripts/swap-env.js dev",
    "env:prod": "node scripts/swap-env.js prod",
    "archive:prod": "npm run env:prod && npx convex deploy && npx expo prebuild --clean --platform ios && open ios/*.xcworkspace && echo '\\n✅ Xcode opened with PROD env. Run: Product > Archive\\n⚠️  When done, run: npm run env:dev to restore dev environment\\n'",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.58",
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@better-auth/expo": "1.5.3",
    "@convex-dev/better-auth": "^0.11.4",
    "@expo-google-fonts/pixelify-sans": "^0.4.2",
    "@expo-google-fonts/press-start-2p": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.6",
    "@shopify/react-native-skia": "2.2.12",
    "@stripe/stripe-react-native": "0.50.3",
    "ai": "^6.0.146",
    "better-auth": "1.5.3",
    "clsx": "^2.1.1",
    "convex": "^1.34.1",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.14",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.9",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-iap": "^3.4.13",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.11",
    "nativewind": "latest",
    "posthog-react-native": "^4.41.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-audio-api": "^0.13.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-worklets": "0.5.1",
    "react-native-zoom-toolkit": "^5.0.1",
    "stripe": "^22.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
